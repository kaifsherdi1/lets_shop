APP_NAME=LetsShop
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-service.up.railway.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Railway captures stdout/stderr — write logs there, not to a file.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_LEVEL=error

# --- Database ---------------------------------------------------------------
# On Railway add a MySQL plugin, then reference it:
#   DB_CONNECTION=mysql
#   DB_URL=${{ MySQL.MYSQL_URL }}
DB_CONNECTION=mysql
DB_URL=

# --- Session / cache / queue (DB-backed, no Redis needed) ------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync

# --- API auth --------------------------------------------------------------
# Sanctum tokens expire after 7 days (10080 minutes).
SANCTUM_TOKEN_EXPIRY=10080

# --- First admin account (created by AdminUserSeeder on deploy) -----------
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-now

# --- Frontend origins (used by config/cors.php) --------------------------
FRONTEND_USER_URL=https://lets-shop-gold.vercel.app
FRONTEND_ADMIN_URL=https://your-admin-dashboard.vercel.app

# --- Email (Resend.com SMTP — free 3k/month) -----------------------------
MAIL_MAILER=log
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=re_your_api_key
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
