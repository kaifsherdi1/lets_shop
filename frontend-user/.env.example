# Base URL of the LetsShop API — must include the trailing /api
#
# Local:       http://localhost:8000/api
# Production:   https://<your-railway-service>.up.railway.app/api
#
# On Vercel, set this in  Project → Settings → Environment Variables  (name: VITE_API_URL)
# and redeploy. Vite reads it at BUILD time, so a redeploy is required after changing it.
VITE_API_URL=http://localhost:8000/api
